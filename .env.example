# Copy to .env.local. Never commit real values.

# Public address of the deployed site (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form (server-side only). Delivery uses the Resend HTTP API.
RESEND_API_KEY=
# Inbox that receives messages.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Portfolio <contact@example.com>"
CONTACT_FROM_EMAIL=

# Optional: shared rate limiting across serverless instances (Upstash Redis REST).
# Without these, a per-instance in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI assistant (server-side only). Create a key at https://aistudio.google.com
GEMINI_API_KEY=
# Optional. Default: gemini-3.5-flash-lite
GEMINI_MODEL=
# Set to true only if the key's Google Cloud project has billing enabled. While it is not true, visitors
# in the EEA, UK and Switzerland are declined (Google's terms require paid service there).
GEMINI_PAID_TIER=
# Optional. Questions answered per day across all visitors. Default: 200
CHAT_DAILY_LIMIT=
